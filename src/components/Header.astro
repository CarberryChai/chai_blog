---
import Link from '@/components/Link.astro'
import MobileMenu from '@/components/ui/mobile-menu'
import { NAV_LINKS, SITE } from '@/consts'
---

<header transition:persist class="glass-header sticky top-0 z-50">
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <Link
      href="/"
      class="flex shrink-0 items-center justify-center gap-3 transition-transform hover:scale-105"
    >
      <span class="hidden h-full text-lg font-semibold min-[300px]:block"
        >{SITE.title}</span
      >
    </Link>
    <div class="flex items-center sm:gap-4">
      <nav class="hidden items-center gap-4 text-sm sm:flex sm:gap-6">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="text-foreground/60 hover:text-foreground after:bg-primary relative capitalize transition-all duration-200 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:transition-all after:duration-200 hover:after:w-full"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <MobileMenu client:load transition:persist />
    </div>
  </div>
</header>
